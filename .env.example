# NEXUS-OSINT environment — all public sources work without keys; optional keys unlock full data
# Threat intel (optional, free-tier)
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
PHISHTANK_API_KEY=
ABUSECH_API_KEY=
# Infrastructure / Search (optional)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
GITHUB_TOKEN=
HUNTER_API_KEY=
CENSYS_API_KEY=
# Blockchain (optional)
ETHERSCAN_API_KEY=
BLOCKCHAIR_API_KEY=
# Geo / Environment (optional, free-tier)
OPENAQ_API_KEY=
# LLM for agent (optional)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:72b
# Infrastructure
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
NEXUS_USE_CELERY=false
NEXUS_JWT_SECRET=replace-with-a-long-random-secret
NEXUS_SESSION_MINUTES=480
NEXUS_CORS_ORIGINS=http://localhost:3000
NEXUS_BOOTSTRAP_ADMIN=admin
NEXUS_BOOTSTRAP_PASSWORD=replace-with-a-long-password
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# OMNI notes: every adapter in backend/osint_core/omni_sources.py is public/free-tier first.
# Without keys you still get 30+ live sources (Shodan InternetDB, IP-API, BGPView, URLScan, Wayback, crt.sh, GitHub public, OpenCorporates, URLhaus, Feodo, OpenPhish, Reddit, Blockchair, Mempool, OpenStreetMap, USGS, NASA EONET, etc.).
# Set the keys above to also enable: VirusTotal, Shodan Full, Censys, Hunter, Etherscan, AbuseIPDB, OTX, HIBP full.
